# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/it_ticket_db

# JWT Secret Key (change this in production!)
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# CORS
FRONTEND_URL=http://localhost:5173

# Web Push (VAPID) — generate with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); v.save_key('private.pem'); v.save_public_key('public.txt')"
VAPID_PUBLIC_KEY=your-base64url-public-key
VAPID_PRIVATE_KEY=your-pem-private-key
VAPID_SUBJECT=mailto:no-reply.it-ticket@ani.co.id
